# PushLaunchPad Deployment Configuration

# ============================================
# Required: Deployment Settings
# ============================================

# Deployer private key (NEVER commit this!)
PRIVATE_KEY=your_private_key_here

# Push Chain RPC endpoint
PUSH_RPC_URL=https://evm.rpc-testnet-donut-node1.push.org/

# ============================================
# Required: External Contract Addresses
# ============================================

# WETH contract address on your target network
# Ethereum Mainnet: 0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2
# Ethereum Sepolia: 0x7b79995e5f793A07Bc00c21412e50Ecae098E7f9
WETH_ADDRESS=0x0000000000000000000000000000000000000000

# Uniswap V2 Router (or compatible DEX router) - Optional if deploying from scratch
UNIV2_ROUTER=0x0000000000000000000000000000000000000000

# Quote Token (USDC, capUSDC, WETH, or stablecoin)
# This is the token users will use to buy newly launched tokens
# Must be 18 decimals for current implementation
QUOTE_TOKEN=0x0000000000000000000000000000000000000000

# ============================================
# Optional: Configuration
# ============================================

# Contract owner address (defaults to deployer if not set)
OWNER_ADDRESS=0x0000000000000000000000000000000000000000

# Launchpad owner address (defaults to OWNER_ADDRESS or deployer)
LAUNCHPAD_OWNER=

# Fee to setter address for Uniswap factory (defaults to deployer)
FEE_TO_SETTER=

# Graduation threshold in quote token (default: 12500 = 125 USDC with 2 decimals)
GRADUATION_THRESHOLD=12500

# ============================================
# Bonding Curve Parameters (Optional)
# ============================================

# Virtual base reserve (default: 1,000,000 tokens = 1e24 wei)
# This represents the initial virtual token supply in the bonding curve
VIRTUAL_BASE=1000000000000000000000000

# Virtual quote reserve (default: 30 ETH = 30e18 wei)  
# This represents the initial virtual quote token supply
VIRTUAL_QUOTE=30000000000000000000

# ============================================
# Etherscan/Block Explorer Verification
# ============================================

# API key for contract verification (optional but recommended)
ETHERSCAN_API_KEY=

# ============================================
# Deployed Contract Addresses (filled after deployment)
# ============================================

# Uniswap V2 Contracts
FACTORY_ADDRESS=
ROUTER_ADDRESS=

# Launchpad System Contracts
SIMPLE_BONDING_CURVE=
LAUNCHPAD_LP_VAULT=
DISTRIBUTOR=
LAUNCHPAD_IMPLEMENTATION=
ERC1967_FACTORY=
LAUNCHPAD_PROXY=

# ============================================
# Push Testnet Example Values
# ============================================
# Replace these with your actual addresses

# Example WETH9 on Push Testnet
# WETH9_ADDRESS=0x0d0dF7E8807430A81104EA84d926139816eC7586

# Example Router (deploy your own or use existing)
# UNIV2_ROUTER=0x...

# Example Quote Token (deploy your own or use existing capUSDC)
# QUOTE_TOKEN=0x...
